digraph G {
  graph [rankdir=TB, nodesep=0.45, ranksep=0.9, fontname="Helvetica", labelloc=t, fontsize=20, label="Class diagram - Banking Management System (C implementation, v2)"];
  node [shape=plain, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9, arrowsize=0.8];
  Client [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#F3F3F3"><B>Client</B><BR/><FONT POINT-SIZE="9" COLOR="#555555">client.c</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+main()<BR ALIGN="LEFT"/>-install_signal_handlers()<BR ALIGN="LEFT"/>-send_all(sock, data, len)<BR ALIGN="LEFT"/>-say(fd, fmt, ...)  // write()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Server [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#F3F3F3"><B>Server</B><BR/><FONT POINT-SIZE="9" COLOR="#555555">server.c</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-client_fds[100]: int<BR ALIGN="LEFT"/>-active_clients: int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+main()<BR ALIGN="LEFT"/>-handle_client(arg)  // one thread per client<BR ALIGN="LEFT"/>-register_client(fd) / unregister_client(fd)<BR ALIGN="LEFT"/>-graceful_shutdown(listen_fd)<BR ALIGN="LEFT"/>+print_server_status()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Signals [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#F3F3F3"><B>Signals</B><BR/><FONT POINT-SIZE="9" COLOR="#555555">signals.c</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-g_running: atomic_int<BR ALIGN="LEFT"/>-g_wake_fd: int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+signals_init(wake_fd)<BR ALIGN="LEFT"/>+server_running()<BR ALIGN="LEFT"/>-signal_thread()  // sigwait()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Auth [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFF4D6"><B>Auth</B><BR/><FONT POINT-SIZE="9" COLOR="#555555">auth.c</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+authenticate(role, user, pass, &amp;id)<BR ALIGN="LEFT"/>+logout_user(role, id)<BR ALIGN="LEFT"/>+change_password(sock, role, id)<BR ALIGN="LEFT"/>+modify_account_details(sock, role)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  SessionManager [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFF4D6"><B>SessionManager</B><BR/><FONT POINT-SIZE="9" COLOR="#555555">session_manager.c</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-sessions[100]: Session  // shared memory<BR ALIGN="LEFT"/>-shm_id: int<BR ALIGN="LEFT"/>-sem_session: int  // semaphore<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+init_session_manager()<BR ALIGN="LEFT"/>+destroy_session_manager()<BR ALIGN="LEFT"/>+check_and_register_login(role, id)<BR ALIGN="LEFT"/>+register_logout(role, id)<BR ALIGN="LEFT"/>+count_active_sessions()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Session [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#FFF4D6"><B>Session</B><BR/><FONT POINT-SIZE="9" COLOR="#555555">common.h</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-role: int<BR ALIGN="LEFT"/>-user_id: int<BR ALIGN="LEFT"/>-active: int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>];
  Customer [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#EAF3FF"><B>Customer</B><BR/><FONT POINT-SIZE="9" COLOR="#555555">customer.c</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-id: int<BR ALIGN="LEFT"/>-username: string<BR ALIGN="LEFT"/>-password: string<BR ALIGN="LEFT"/>-balance: double<BR ALIGN="LEFT"/>-active: int  // 0 deactivated, 1 active, 2 closed<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+handle_customer(sock, id)<BR ALIGN="LEFT"/>-view_balance()<BR ALIGN="LEFT"/>-update_balance()  // deposit / withdraw<BR ALIGN="LEFT"/>-transfer_funds()<BR ALIGN="LEFT"/>-apply_loan()<BR ALIGN="LEFT"/>-check_loan_status()<BR ALIGN="LEFT"/>-add_feedback()<BR ALIGN="LEFT"/>-view_transactions()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Employee [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#EAF3FF"><B>Employee</B><BR/><FONT POINT-SIZE="9" COLOR="#555555">employee.c</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-id: int<BR ALIGN="LEFT"/>-username: string<BR ALIGN="LEFT"/>-password: string<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+handle_employee(sock, id)<BR ALIGN="LEFT"/>-add_customer()<BR ALIGN="LEFT"/>-close_account()<BR ALIGN="LEFT"/>-process_loan()  // approve / reject<BR ALIGN="LEFT"/>-credit_customer()<BR ALIGN="LEFT"/>-view_assigned_loans()<BR ALIGN="LEFT"/>-view_customer_transactions()  // passbook<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Manager [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#EAF3FF"><B>Manager</B><BR/><FONT POINT-SIZE="9" COLOR="#555555">manager.c</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-id: int<BR ALIGN="LEFT"/>-username: string<BR ALIGN="LEFT"/>-password: string<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+handle_manager(sock, id)<BR ALIGN="LEFT"/>-activate_account()  // activate / deactivate<BR ALIGN="LEFT"/>-assign_loan()<BR ALIGN="LEFT"/>-view_feedback()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Admin [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#EAF3FF"><B>Admin</B><BR/><FONT POINT-SIZE="9" COLOR="#555555">admin.c</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-id: int<BR ALIGN="LEFT"/>-username: string<BR ALIGN="LEFT"/>-password: string<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+handle_admin(sock, id)<BR ALIGN="LEFT"/>-add_employee()<BR ALIGN="LEFT"/>-manage_user_roles()<BR ALIGN="LEFT"/>-move_staff()  // promote / demote<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Loan [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E8F7EA"><B>Loan</B><BR/><FONT POINT-SIZE="9" COLOR="#555555">loans.csv / LoanRecord</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-loan_id: int<BR ALIGN="LEFT"/>-customer_id: int<BR ALIGN="LEFT"/>-amount: double<BR ALIGN="LEFT"/>-type[20]: char<BR ALIGN="LEFT"/>-tenure: int<BR ALIGN="LEFT"/>-status[20]: char  // pending / approved / rejected<BR ALIGN="LEFT"/>-assigned[20]: char  // employee id or unassigned<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>];
  Feedback [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E8F7EA"><B>Feedback</B><BR/><FONT POINT-SIZE="9" COLOR="#555555">feedback.csv / FeedbackRecord</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-id: int<BR ALIGN="LEFT"/>-customer_id: int<BR ALIGN="LEFT"/>-message[256]: char<BR ALIGN="LEFT"/>-reviewed: int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>];
  Transaction [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E8F7EA"><B>Transaction</B><BR/><FONT POINT-SIZE="9" COLOR="#555555">transactions.csv</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-customer_id: int<BR ALIGN="LEFT"/>-type[20]: char<BR ALIGN="LEFT"/>-amount: double<BR ALIGN="LEFT"/>-balance_after: double<BR ALIGN="LEFT"/>-timestamp[50]: char<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>];
  Records [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#F5E9FF"><B>Records</B><BR/><FONT POINT-SIZE="9" COLOR="#555555">records.c</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+parse_account_line() / format_account_line() / write_account_line()<BR ALIGN="LEFT"/>+parse_loan_line() / format_loan_line() / write_loan_line()<BR ALIGN="LEFT"/>+parse_feedback_line() / format_feedback_line() / write_feedback_line()<BR ALIGN="LEFT"/>+find_account_by_id() / find_account_by_username()<BR ALIGN="LEFT"/>+role_csv_path() / role_tmp_path() / role_db()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Utils [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#F5E9FF"><B>Utils</B><BR/><FONT POINT-SIZE="9" COLOR="#555555">utils.c</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-db_locks[7]: pthread_rwlock_t  // one per CSV file<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+db_rdlock() / db_wrlock() / db_unlock()<BR ALIGN="LEFT"/>+lock_file() / unlock_file()  // fcntl<BR ALIGN="LEFT"/>+send_message() / read_input()  // socket<BR ALIGN="LEFT"/>+write_all() / append_line()  // write + fsync<BR ALIGN="LEFT"/>+log_out() / log_err()  // write(2)<BR ALIGN="LEFT"/>+log_transaction()<BR ALIGN="LEFT"/>+get_next_id_csv()<BR ALIGN="LEFT"/>+parse_amount() / parse_int() / is_valid_field()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  CsvRewrite [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#F5E9FF"><B>CsvRewrite</B><BR/><FONT POINT-SIZE="9" COLOR="#555555">utils.c</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-fd: int<BR ALIGN="LEFT"/>-in: LineReader<BR ALIGN="LEFT"/>-out: StrBuf<BR ALIGN="LEFT"/>-path, tmp: string<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+csv_rewrite_begin()  // open + fcntl lock + read()<BR ALIGN="LEFT"/>+csv_rewrite_commit()  // write + fsync + rename + fsync(dir)<BR ALIGN="LEFT"/>+csv_rewrite_abort()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  LineReader [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#F5E9FF"><B>LineReader</B><BR/><FONT POINT-SIZE="9" COLOR="#555555">utils.c</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-data: char*<BR ALIGN="LEFT"/>-len: size_t<BR ALIGN="LEFT"/>-pos: size_t<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+lr_open() / lr_from_fd()  // open + read<BR ALIGN="LEFT"/>+lr_next()<BR ALIGN="LEFT"/>+lr_close()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  StrBuf [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#F5E9FF"><B>StrBuf</B><BR/><FONT POINT-SIZE="9" COLOR="#555555">utils.c</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-data: char*<BR ALIGN="LEFT"/>-len, cap: size_t<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+sb_appendf() / sb_puts()<BR ALIGN="LEFT"/>+sb_free()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];

  Client -> Server [label="TCP socket\n(line protocol)", style=bold];
  Server -> Signals [label="uses", style=dashed];
  Server -> SessionManager [label="init / destroy", style=dashed];
  Server -> Auth [label="authenticate()", style=dashed];
  Server -> Customer [label="role 1", style=dashed];
  Server -> Employee [label="role 2", style=dashed];
  Server -> Manager [label="role 3", style=dashed];
  Server -> Admin [label="role 4", style=dashed];
  Auth -> SessionManager [label="check_and_register_login\nregister_logout", style=dashed];
  SessionManager -> Session [label="1 .. 100", arrowhead=diamond, dir=back, arrowtail=diamond, arrowhead=none];
  Customer -> Auth [label="change_password", style=dashed];
  Employee -> Auth [label="change_password\nmodify_account_details", style=dashed];
  Manager -> Auth [label="change_password", style=dashed];
  Admin -> Auth [label="change_password\nmodify_account_details", style=dashed];
  Customer -> Loan [label="applies / checks\n0..*"];
  Customer -> Feedback [label="submits\n0..*"];
  Customer -> Transaction [label="views / logs\n0..*"];
  Employee -> Customer [label="adds / closes /\ncredits loan"];
  Employee -> Loan [label="approves / rejects"];
  Employee -> Transaction [label="passbook"];
  Manager -> Customer [label="activates /\ndeactivates"];
  Manager -> Loan [label="assigns"];
  Manager -> Employee [label="assigns loan to"];
  Manager -> Feedback [label="reviews"];
  Admin -> Employee [label="adds / modifies"];
  Admin -> Manager [label="promotes / demotes"];
  Auth -> Records [style=dashed];
  Auth -> CsvRewrite [style=dashed];
  CsvRewrite -> LineReader [arrowhead=diamond, label="has"];
  CsvRewrite -> StrBuf [arrowhead=diamond, label="has"];
  Records -> StrBuf [style=dashed];
  Note [shape=note, fontsize=9, label="Every module above also uses Utils\n(locks, socket I/O, logging, write+fsync),\nRecords and CsvRewrite for the CSV files.\nNo fopen/FILE*, no fork: only system calls\nand POSIX threads."];
  Note -> Utils [style=dotted, arrowhead=none];
  Utils -> CsvRewrite [style=dotted, label="provides"];
  { rank=same; Client; Server; Signals; }
  { rank=same; Auth; SessionManager; Session; }
  { rank=same; Customer; Employee; Manager; Admin; }
  { rank=same; Loan; Feedback; Transaction; }
  { rank=same; Records; Utils; CsvRewrite; LineReader; StrBuf; }
}
